{
  "name": "@webship.co/workspace-payload",
  "version": "1.0.0",
  "description": "Payload for Webship Workspace: the builder (`cmd-payload-project.sh`, an app made with the official installer, create-payload-app, from the website or the blank template, on PostgreSQL, with roles for its accounts and the website template's own seed on request) and the Payload CLI tool in every sites folder, the default accounts, the Payload step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-payload.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "payload",
    "label": "Payload",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-payload-project.sh",
        "commands/cmd-tools-payload-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-payload.sh"
      ],
      "args": [
        "scripts/args/arg-payload.sh",
        "scripts/args/arg-payload-cli.sh"
      ],
      "machine": [
        "scripts/payload-site.mjs",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/payload-site-builder.md",
        "ai/agents/payload-tester.md"
      ],
      "skills": [
        "ai/skills/payload-scenarios"
      ],
      "commands": [
        "ai/commands/payload-test.md"
      ],
      "prompts": [
        "ai/prompts/payload-build-and-test.md",
        "ai/prompts/payload-scenarios-for-an-area.md"
      ]
    },
    "features": [
      "features/payload.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
